<!DOCTYPE html>
<html lang="en">
  <head>
    <title>AppUrl · Worktree check</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <style>
      :root { color-scheme: light; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #202e35; background: #f3f5f1; }
      * { box-sizing: border-box; }
      body { margin: 0; }
      main { max-width: 980px; margin: 0 auto; padding: 64px 24px; }
      .eyebrow { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .16em; color: #476758; }
      h1 { font-size: clamp(32px, 6vw, 52px); letter-spacing: -.045em; margin: 14px 0; font-weight: 650; }
      .intro { max-width: 600px; font-size: 17px; line-height: 1.6; color: #61706f; margin-bottom: 32px; }
      .panel { background: #fff; border: 1px solid #dce3dc; border-radius: 16px; padding: 28px; margin: 20px 0; }
      h2 { font-size: 18px; margin: 0 0 8px; }
      .muted { color: #61706f; font-size: 14px; line-height: 1.6; }
      dl { margin: 20px 0 0; }
      .row { display: grid; grid-template-columns: minmax(170px, 1fr) 2fr; gap: 20px; padding: 16px 0; border-top: 1px solid #edf0eb; }
      dt { font-size: 13px; color: #61706f; }
      dd { margin: 0; overflow-wrap: anywhere; font-size: 14px; font-family: ui-monospace, SFMono-Regular, monospace; }
      a { color: #25674d; text-underline-offset: 3px; }
      .status { display: inline-block; font-size: 13px; border-radius: 20px; padding: 7px 12px; background: #eef1eb; margin: 14px 0; }
      .status[data-state="ok"] { background: #e2f2e6; color: #226c42; }
      .status[data-state="error"] { background: #f9e5df; color: #943f25; }
      footer { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; font-size: 12px; color: #61706f; padding-top: 12px; }
      @media (max-width: 600px) { main { padding: 36px 18px; } .panel { padding: 22px; } .row { grid-template-columns: 1fr; gap: 8px; } }
    </style>
  </head>
  <body><%= yield %></body>
</html>
